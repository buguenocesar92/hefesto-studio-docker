---
import SolutionConfigurator from '../../components/react/SolutionConfigurator';
import { getEcosystemSolutions, type EcosystemSolution } from '../../lib/hefesto-scaffolding';

export async function getStaticPaths() {
  const solutions = await getEcosystemSolutions();
  return solutions.map((solution) => ({
    params: { id: solution.id },
    props: { solution },
  }));
}

interface Props {
  solution: EcosystemSolution;
}

const { solution } = Astro.props;
const publicApiUrl = import.meta.env.PUBLIC_HEFESTO_API_URL ?? '';
---

<!doctype html>
<html lang="es" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{`${solution.name} · Ecosistema Hefesto Studio`}</title>
    <meta name="description" content={solution.body_es} />
    <link rel="canonical" href={`https://hefesto-studio.cl/soluciones/${solution.id}/`} />
    <link rel="stylesheet" href="../../proyectos/kraftdo/case.css?v=2" />
    <link rel="stylesheet" href="../../proyectos/products.css?v=1" />
  </head>
  <body>
    <header class="top">
      <a href="../../index.html" class="wordmark">HEFESTO<span> / ECOSISTEMA</span></a>
      <div class="controls">
        <a href="../../index.html#ecosistema" style="color:inherit;text-decoration:none;font-size:13px;">← Volver al ecosistema</a>
      </div>
    </header>
    <main id="main" style="max-width: 1080px; margin: 0 auto; padding: 48px 24px;">
      <section class="product-hero">
        <div class="product-kicker">
          <a href="../../index.html#ecosistema">← Ecosistema Hefesto</a>
          <span>{`SOLUCIÓN / ${solution.category.toUpperCase()}`}</span>
        </div>
        <div class="product-intro">
          <div>
            <p class="eyebrow">{`${solution.name} · ${solution.kind_es}`}</p>
            <h1>{solution.title_es}</h1>
          </div>
          <div class="product-intro-right">
            <p class="lead">{solution.body_es}</p>
            <div class="actions">
              <a class="button" href={`../../index.html?solucion=${solution.id}#cotizador`}>
                Cotizar implementación ↗
              </a>
              <a class="button ghost" href={solution.url} target="_blank" rel="noopener noreferrer">
                Documentación oficial ↗
              </a>
            </div>
            <p class="product-small">
              {`Estado: ${solution.status} · Verificado: ${solution.verified_on} · Fuente: ${solution.source ?? 'local'}`}
            </p>
          </div>
        </div>
      </section>

      <SolutionConfigurator solution={solution} apiBaseUrl={publicApiUrl} client:load />
    </main>
    <footer>
      <a href="../../index.html">← HEFESTO STUDIO</a>
      <a href="../../index.html#plantillas">Explorar plantillas</a>
    </footer>
  </body>
</html>
