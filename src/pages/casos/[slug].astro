---
import { getDynamicCases, type DynamicCaseSummary } from '../../lib/hefesto-scaffolding';

export async function getStaticPaths() {
  const cases = await getDynamicCases();
  return cases.map((item) => ({
    params: { slug: item.slug },
    props: { item },
  }));
}

interface Props {
  item: DynamicCaseSummary;
}

const { item } = Astro.props;
---

<!doctype html>
<html lang="es" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{`${item.name} · Casos Hefesto Studio`}</title>
    <meta name="description" content={item.summary_es} />
    <link rel="canonical" href={`https://hefesto-studio.cl/casos/${item.slug}/`} />
    <link rel="stylesheet" href="../../proyectos/kraftdo/case.css?v=2" />
    <link rel="stylesheet" href="../../proyectos/products.css?v=1" />
  </head>
  <body>
    <header class="top">
      <a href="../../index.html" class="wordmark">HEFESTO<span> / CASOS</span></a>
      <div class="controls">
        <a href="../../index.html#proyectos" style="color:inherit;text-decoration:none;font-size:13px;">← Proyectos</a>
      </div>
    </header>
    <main id="main" style="max-width: 980px; margin: 0 auto; padding: 48px 24px;">
      <section class="product-hero">
        <div class="product-kicker">
          <a href="../../index.html#proyectos">← Proyectos Hefesto</a>
          <span>{`CASO · ${item.type.toUpperCase()} · ${item.source.toUpperCase()}`}</span>
        </div>
        <div class="product-intro">
          <div>
            <p class="eyebrow">{item.status}</p>
            <h1>{item.name}</h1>
          </div>
          <div class="product-intro-right">
            <p class="lead">{item.summary_es}</p>
            <div class="actions">
              <a class="button" href={`../..${item.detailHref}`}>
                Ver vista completa del proyecto ↗
              </a>
              {item.url && (
                <a class="button ghost" href={item.url} target="_blank" rel="noopener noreferrer">
                  Sitio en vivo ↗
                </a>
              )}
            </div>
          </div>
        </div>
      </section>
      <section class="section">
        <p class="eyebrow">STACK TECNOLÓGICO</p>
        <div class="stack">
          {item.stack.map((s) => (
            <span>{s}</span>
          ))}
        </div>
      </section>
    </main>
    <footer>
      <a href="../../index.html">← HEFESTO STUDIO</a>
      <a href="../../index.html#cotizador">Solicitar cotización</a>
    </footer>
  </body>
</html>
