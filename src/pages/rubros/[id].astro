---
import RubroExplorer from '../../components/react/RubroExplorer';
import { getRubrosCatalog, type RubroPack } from '../../lib/hefesto-scaffolding';

export async function getStaticPaths() {
  const packs = await getRubrosCatalog();
  return packs.map((pack) => ({
    params: { id: pack.id },
    props: { pack },
  }));
}

interface Props {
  pack: RubroPack;
}

const { pack } = Astro.props;
---

<!doctype html>
<html lang="es" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{`${pack.name} · Biblioteca de Rubros Hefesto Studio`}</title>
    <meta name="description" content={`${pack.brand?.headline ?? pack.name} — Plantilla y arquitectura modular para ${pack.category}.`} />
    <link rel="canonical" href={`https://hefesto-studio.cl/rubros/${pack.id}/`} />
    <link rel="stylesheet" href="../../proyectos/kraftdo/case.css?v=2" />
    <link rel="stylesheet" href="../../proyectos/products.css?v=1" />
  </head>
  <body>
    <header class="top">
      <a href="../../index.html" class="wordmark">HEFESTO<span> / RUBROS</span></a>
      <div class="controls">
        <a href="../../plantillas/index.html" style="color:inherit;text-decoration:none;font-size:13px;">← Biblioteca de 48 rubros</a>
      </div>
    </header>
    <main id="main" style="max-width: 1080px; margin: 0 auto; padding: 48px 24px;">
      <section class="product-hero">
        <div class="product-kicker">
          <a href="../../plantillas/index.html">← Biblioteca de rubros</a>
          <span>{`${pack.category.toUpperCase()} · PLAN MÍNIMO: ${pack.minimum_plan.toUpperCase()}`}</span>
        </div>
        <div class="product-intro">
          <div>
            <p class="eyebrow">{`${pack.name} · ${pack.brand?.name ?? ''}`}</p>
            <h1>{pack.brand?.headline ?? pack.name}</h1>
          </div>
          <div class="product-intro-right">
            <p class="lead">
              {`Diseño base "${pack.layout}" preparado para ${pack.name} (${pack.category}). Incluye categorías (${(pack.categories ?? []).join(', ')}) y páginas (${(pack.pages ?? []).join(', ')}).`}
            </p>
            <div class=" stack" style="display:flex;flex-wrap:wrap;gap:8px;margin-top:14px;">
              {(pack.tags ?? []).map((tag) => (
                <span style="padding:4px 10px;border:1px solid rgba(255,255,255,0.16);border-radius:999px;font-size:12px;">
                  {tag}
                </span>
              ))}
            </div>
          </div>
        </div>
      </section>

      <RubroExplorer pack={pack} client:load />
    </main>
    <footer>
      <a href="../../index.html">← HEFESTO STUDIO</a>
      <a href="../../plantillas/index.html">Ver los 48 rubros</a>
    </footer>
  </body>
</html>
