---
import type { KraftdoCaseData } from '../../lib/hefesto-scaffolding';

interface Props {
  caseData: KraftdoCaseData;
}

const { caseData: d } = Astro.props;

const themes = [
  { value: 'light', es: 'Claro', en: 'Light' },
  { value: 'dark', es: 'Oscuro', en: 'Dark' },
  { value: 'system', es: 'Sistema', en: 'System' },
];

const filters = [
  { value: 'all', es: 'Todo el proyecto', en: 'Full project' },
  { value: 'experience', es: 'Experiencia digital', en: 'Digital experience' },
  { value: 'business', es: 'Negocio y ventas', en: 'Business and sales' },
  { value: 'operations', es: 'Operación y seguridad', en: 'Operations and security' },
];

const engineeringServices = [
  {
    es: 'Diseño y desarrollo',
    en: 'Design and development',
    body_es: 'Interfaz, adaptación de identidad visual, experiencia responsive y construcción de funcionalidades a medida.',
    body_en: 'Interface design, visual identity adaptation, responsive experience and custom feature development.',
  },
  {
    es: 'Integración y calidad',
    en: 'Integration and quality',
    body_es: 'Conexión de formularios, permisos por propietario, corrección de sesiones y comprobaciones automatizadas de los flujos.',
    body_en: 'Connected forms, ownership permissions, session fixes and automated flow checks.',
  },
  {
    es: 'Entrega y continuidad',
    en: 'Delivery and continuity',
    body_es: 'Documentación, exportaciones, respaldo y restauración; adaptación de infraestructura para una futura operación en VPS.',
    body_en: 'Documentation, exports, backup and restore; infrastructure adaptation for future VPS operation.',
  },
];

const scopeDetails = [
  {
    es: 'Flow · Pagos',
    en: 'Flow · Payments',
    body_es: 'Conector desarrollado y configuración sandbox documentada. La operación productiva y el plan mensual requieren credenciales y definición comercial.',
    body_en: 'Connector developed and sandbox setup documented. Production operation and the monthly plan require credentials and commercial configuration.',
  },
  {
    es: 'Google, Facebook, Instagram y Canva',
    en: 'Google, Facebook, Instagram and Canva',
    body_es: 'Flujos implementados. La disponibilidad depende de cuentas autorizadas, permisos, configuración y revisión de cada proveedor.',
    body_en: 'Flows implemented. Availability depends on authorised accounts, permissions, setup and each provider’s review.',
  },
  {
    es: 'Despacho y Starken',
    en: 'Shipping and Starken',
    body_es: 'Cálculo con tarifas registradas. La cotización automática con el transportista requiere acceso a su API.',
    body_en: 'Calculation with registered rates. Automatic carrier quotes require API access.',
  },
  {
    es: 'VPS y continuidad',
    en: 'VPS and continuity',
    body_es: 'Variante Docker/Caddy y procedimientos de migración preparados. No se presenta como una migración a VPS ya completada.',
    body_en: 'Docker/Caddy variant and migration procedures prepared. This is not presented as an already completed VPS migration.',
  },
];
---

<!doctype html>
<html lang="es" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>KraftDo — Primer proyecto a medida | Hefesto Studio</title>
    <meta
      name="description"
      content="KraftDo, primer cliente y proyecto a medida de Hefesto: sitio web, plataforma NFC/QR, regalos digitales, gestión, pedidos, seguridad e integraciones."
    />
    <meta property="og:title" content="Hefesto × KraftDo · Del objeto a todo un ecosistema" />
    <meta property="og:description" content="Conoce el primer proyecto a medida de Hefesto Studio." />
    <meta property="og:image" content="https://hefesto-studio.cl/proyectos/kraftdo/assets/tarjeta-nfc-telefono.webp" />
    <link rel="stylesheet" href="case.css?v=2" />
    <script is:inline>
      try {
        let p = localStorage.getItem('hefesto-theme') || 'system';
        document.documentElement.dataset.theme =
          p === 'system' ? (matchMedia('(prefers-color-scheme:dark)').matches ? 'dark' : 'light') : p;
      } catch {}
    </script>
  </head>
  <body>
    <a href="#main" class="skip" data-es="Saltar al contenido" data-en="Skip to content">Saltar al contenido</a>
    <header class="top">
      <a href="../../index.html" class="wordmark">HEFESTO<span> / ESTUDIO</span></a>
      <div class="controls">
        {themes.map((t) => (
          <button
            type="button"
            data-theme-choice={t.value}
            aria-pressed="false"
            data-es={t.es}
            data-en={t.en}
          >
            {t.es}
          </button>
        ))}
        <span class="divider"></span>
        <button type="button" data-lang="es" aria-pressed="true">ES</button>
        <button type="button" data-lang="en" aria-pressed="false">EN</button>
      </div>
    </header>

    <main id="main">
      <section class="hero">
        <div class="hero-copy">
          <p class="eyebrow" data-es="CASO 001 / PRIMER CLIENTE DE HEFESTO" data-en="CASE 001 / HEFESTO’S FIRST CLIENT">
            CASO 001 / PRIMER CLIENTE DE HEFESTO
          </p>
          <div class="collab">
            <span data-es="PROYECTO A MEDIDA / KRAFTDO" data-en="CUSTOM PROJECT / KRAFTDO">PROYECTO A MEDIDA / KRAFTDO</span>
          </div>
          <h1 data-es={'KraftDo.\nDe la idea\nal sistema.'} data-en={'KraftDo.\nFrom idea\nto system.'}>
            {'KraftDo.\nDe la idea\nal sistema.'}
          </h1>
          <p
            class="lead"
            data-es="De una marca que conecta objetos con personas, a una plataforma que conecta toda su operación. Nuestro primer proyecto a medida."
            data-en="From a brand that connects objects with people to a platform that connects its operations. Our first custom project."
          >
            De una marca que conecta objetos con personas, a una plataforma que conecta toda su operación. Nuestro primer proyecto a medida.
          </p>
          <div class="actions">
            <a class="button" href="#alcance">
              <span data-es="Explorar el proyecto ↓" data-en="Explore the project ↓">Explorar el proyecto ↓</span>
            </a>
            <a class="button ghost" href={d.urls.website} target="_blank" rel="noopener noreferrer">
              <span data-es="Visitar KraftDo ↗" data-en="Visit KraftDo ↗">Visitar KraftDo ↗</span>
            </a>
          </div>
        </div>
        <figure class="hero-image">
          <img
            src="assets/tarjeta-nfc-telefono.webp"
            width="1440"
            height="1920"
            alt="Tarjeta NFC KraftDo junto a un perfil digital en un teléfono"
            fetchpriority="high"
          />
          <figcaption>
            <span data-es="DEL MUNDO FÍSICO AL DIGITAL" data-en="FROM PHYSICAL TO DIGITAL">DEL MUNDO FÍSICO AL DIGITAL</span>
            <b>NFC + QR</b>
          </figcaption>
        </figure>
      </section>

      <nav class="case-nav" aria-label="Case study">
        <a href="#alcance"><span data-es="El proyecto" data-en="The project">El proyecto</span></a>
        <a href="#integraciones"><span data-es="Integraciones" data-en="Integrations">Integraciones</span></a>
        <a href="../../index.html#ecosistema"><span data-es="Ecosistema Hefesto" data-en="Hefesto ecosystem">Ecosistema Hefesto</span></a>
      </nav>

      <div class="ribbon" aria-hidden="true">
        <div>DISEÑO · SOFTWARE · NFC / QR · COMERCIO · AUTOMATIZACIÓN · INGENIERÍA · DISEÑO · SOFTWARE · NFC / QR · COMERCIO · AUTOMATIZACIÓN · INGENIERÍA · </div>
      </div>

      <section class="section intro">
        <div>
          <p class="eyebrow" data-es="01 / EL DESAFÍO" data-en="01 / THE CHALLENGE">01 / EL DESAFÍO</p>
          <h2 data-es="La experiencia no termina en la tarjeta." data-en="The experience goes beyond the card.">
            La experiencia no termina en la tarjeta.
          </h2>
        </div>
        <div>
          <p
            class="lead"
            data-es="KraftDo combina diseño, personalización y productos NFC/QR. El desafío fue dar continuidad a esa propuesta: presentar la marca, crear experiencias digitales y organizar los procesos detrás de cada pedido."
            data-en="KraftDo brings together design, personalisation and NFC/QR products. The challenge was to carry that promise through: present the brand, create digital experiences and organise the processes behind each order."
          >
            KraftDo combina diseño, personalización y productos NFC/QR. El desafío fue dar continuidad a esa propuesta: presentar la marca, crear experiencias digitales y organizar los procesos detrás de cada pedido.
          </p>
          <p
            data-es="Hefesto trabajó en el diseño y desarrollo de la web y la plataforma, los flujos de clientes, la gestión interna, las integraciones y la preparación técnica para mantener y evolucionar el producto."
            data-en="Hefesto worked on website and platform design and development, customer journeys, internal operations, integrations and the technical foundation for maintaining and evolving the product."
          >
            Hefesto trabajó en el diseño y desarrollo de la web y la plataforma, los flujos de clientes, la gestión interna, las integraciones y la preparación técnica para mantener y evolucionar el producto.
          </p>
        </div>
      </section>

      <section class="section" id="alcance">
        <div class="section-heading">
          <div>
            <p class="eyebrow" data-es="02 / ALCANCE DEL DESARROLLO" data-en="02 / DEVELOPMENT SCOPE">02 / ALCANCE DEL DESARROLLO</p>
            <h2 data-es="Una solución. Muchas piezas conectadas." data-en="One solution. Many connected parts.">
              Una solución. Muchas piezas conectadas.
            </h2>
          </div>
          <p data-es="Explora las funcionalidades desarrolladas para KraftDo." data-en="Explore the features developed for KraftDo.">
            Explora las funcionalidades desarrolladas para KraftDo.
          </p>
        </div>
        <div class="filters" role="group" aria-label="Filtrar funcionalidades">
          {filters.map((f) => (
            <button
              type="button"
              data-filter={f.value}
              aria-pressed={f.value === 'all' ? 'true' : 'false'}
              data-es={f.es}
              data-en={f.en}
            >
              {f.es}
            </button>
          ))}
        </div>
        <p class="sr-only" id="filter-status" aria-live="polite"></p>
        <div class="feature-grid">
          {d.features.map((f, i) => (
            <article class="feature" data-category={f.category}>
              <span class="index">{String(i + 1).padStart(2, '0')} /</span>
              <h3 data-es={f.title_es} data-en={f.title_en}>{f.title_es}</h3>
              <p data-es={f.body_es} data-en={f.body_en}>{f.body_es}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="gallery section">
        <figure>
          <img loading="lazy" src="assets/tags-nfc-3d.webp" width="1080" height="1350" alt="Tags NFC personalizados KraftDo" />
          <figcaption>
            <span data-es="Pequeños objetos. Nuevas conexiones." data-en="Small objects. New connections.">
              Pequeños objetos. Nuevas conexiones.
            </span>
          </figcaption>
        </figure>
        <div class="gallery-copy">
          <p class="eyebrow" data-es="TECNOLOGÍA CON UN PROPÓSITO" data-en="TECHNOLOGY WITH A PURPOSE">
            TECNOLOGÍA CON UN PROPÓSITO
          </p>
          <h2
            data-es={'Lo tangible abre la puerta.\nEl software hace el resto.'}
            data-en={'The tangible opens the door.\nSoftware does the rest.'}
          >
            {'Lo tangible abre la puerta.\nEl software hace el resto.'}
          </h2>
          <p
            data-es="Perfiles, recuerdos y contenido que acompañan al producto. Una misma identidad desde el primer contacto con la marca hasta la experiencia que se comparte."
            data-en="Profiles, memories and content that accompany the product. One identity from the first brand interaction to the experience people share."
          >
            Perfiles, recuerdos y contenido que acompañan al producto. Una misma identidad desde el primer contacto con la marca hasta la experiencia que se comparte.
          </p>
        </div>
        <figure>
          <img loading="lazy" src="assets/cuadro-graduacion.webp" width="1440" height="1919" alt="Cuadro de graduación personalizado KraftDo" />
          <figcaption>
            <span data-es="Recuerdos físicos con una dimensión digital." data-en="Physical memories with a digital dimension.">
              Recuerdos físicos con una dimensión digital.
            </span>
          </figcaption>
        </figure>
      </section>

      <section class="section">
        <p class="eyebrow">03 / HEFESTO ENGINEERING</p>
        <h2 data-es="El trabajo que no siempre se ve." data-en="The work you don’t always see.">
          El trabajo que no siempre se ve.
        </h2>
        <div class="services">
          {engineeringServices.map((s) => (
            <article>
              <h3 data-es={s.es} data-en={s.en}>{s.es}</h3>
              <p data-es={s.body_es} data-en={s.body_en}>{s.body_es}</p>
            </article>
          ))}
        </div>
        <div class="stack">
          {d.stack.map((item) => (
            <span>{item}</span>
          ))}
        </div>
      </section>

      <section class="section status">
        <div>
          <p class="eyebrow" data-es="04 / INTEGRACIONES CON ALCANCE CLARO" data-en="04 / CLEAR INTEGRATION SCOPE">
            04 / INTEGRACIONES CON ALCANCE CLARO
          </p>
          <h2 data-es="Desarrollado para conectar." data-en="Built to connect.">Desarrollado para conectar.</h2>
          <p
            data-es="La implementación y la activación comercial son etapas distintas."
            data-en="Implementation and commercial activation are different stages."
          >
            La implementación y la activación comercial son etapas distintas.
          </p>
        </div>
        <div>
          {scopeDetails.map((sd) => (
            <details>
              <summary><span data-es={sd.es} data-en={sd.en}>{sd.es}</span></summary>
              <p data-es={sd.body_es} data-en={sd.body_en}>{sd.body_es}</p>
            </details>
          ))}
        </div>
      </section>

      <section class="section integration-section" id="integraciones">
        <p class="eyebrow">04.1 / HEFESTO · CONNECTED SYSTEMS</p>
        <h2 data-es="Cada conexión resuelve algo." data-en="Every connection solves something.">
          Cada conexión resuelve algo.
        </h2>
        <p
          class="lead"
          data-es="El alcance completo de integraciones y componentes conectados desarrollados para KraftDo."
          data-en="The complete scope of integrations and connected components developed for KraftDo."
        >
          El alcance completo de integraciones y componentes conectados desarrollados para KraftDo.
        </p>
        <div class="integration-list">
          {d.integrations.map((item, n) => (
            <details class="integration">
              <summary>
                <span class="index">{String(n + 1).padStart(2, '0')}</span>
                <strong>{item.name}</strong>
                <span data-es={item.title_es} data-en={item.title_en}>{item.title_es}</span>
                <b aria-hidden="true">+</b>
              </summary>
              <div>
                <p data-es={item.body_es} data-en={item.body_en}>{item.body_es}</p>
                <p class="integration-status" data-es={item.status_es} data-en={item.status_en}>{item.status_es}</p>
              </div>
            </details>
          ))}
        </div>
      </section>

      <section class="section promotion">
        <img src="assets/kraftdo-logo.svg" width="180" height="70" alt="KraftDo" />
        <h2 data-es="Conoce lo que están creando." data-en="Discover what they’re creating.">
          Conoce lo que están creando.
        </h2>
        <p
          data-es="Tarjetas inteligentes, productos personalizados y recuerdos que conectan. Descubre KraftDo y entra a su plataforma."
          data-en="Smart cards, personalised products and memories that connect. Discover KraftDo and visit its platform."
        >
          Tarjetas inteligentes, productos personalizados y recuerdos que conectan. Descubre KraftDo y entra a su plataforma.
        </p>
        <div class="actions">
          <a class="button" href={d.urls.website} target="_blank" rel="noopener noreferrer">
            <span data-es="Conocer KraftDo ↗" data-en="Discover KraftDo ↗">Conocer KraftDo ↗</span>
          </a>
          <a class="button ghost" href={d.urls.platform} target="_blank" rel="noopener noreferrer">
            <span data-es="Entrar a la plataforma ↗" data-en="Open the platform ↗">Entrar a la plataforma ↗</span>
          </a>
          <a class="button ghost" href={d.urls.instagram} target="_blank" rel="noopener noreferrer">
            <span data-es="Instagram ↗" data-en="Instagram ↗">Instagram ↗</span>
          </a>
        </div>
      </section>

      <section class="section closing">
        <p class="eyebrow" data-es="TU NEGOCIO PUEDE SER EL SIGUIENTE" data-en="YOUR BUSINESS COULD BE NEXT">
          TU NEGOCIO PUEDE SER EL SIGUIENTE
        </p>
        <h2 data-es={'¿Qué necesitas\nconectar tú?'} data-en={'What do you need\nto connect?'}>
          {'¿Qué necesitas\nconectar tú?'}
        </h2>
        <a class="button" href="../../index.html?proyecto=kraftdo#contacto">
          <span data-es="Construyamos tu proyecto ↗" data-en="Let’s build your project ↗">Construyamos tu proyecto ↗</span>
        </a>
      </section>
    </main>

    <footer>
      <a class="back" href="../../index.html">
        <span data-es="← Volver a Hefesto" data-en="← Back to Hefesto">← Volver a Hefesto</span>
      </a>
      <p
        data-es="Fotografías oficiales de KraftDo · Caso de estudio de Hefesto Studio"
        data-en="Official KraftDo photographs · A Hefesto Studio case study"
      >
        Fotografías oficiales de KraftDo · Caso de estudio de Hefesto Studio
      </p>
      <a class="back" href="../../index.html#plantillas">
        <span data-es="Explorar plantillas" data-en="Explore templates">Explorar plantillas</span>
      </a>
    </footer>

    <script is:inline src="case.js?v=2"></script>
  </body>
</html>
