---
import type { ProductRecord } from '../../lib/hefesto-scaffolding';

interface Props {
  product: ProductRecord;
}

const { product: p } = Astro.props;

const themes = [
  { value: 'light', es: 'Claro', en: 'Light' },
  { value: 'dark', es: 'Oscuro', en: 'Dark' },
  { value: 'system', es: 'Sistema', en: 'System' },
];

const deliverySteps = [
  [
    'Diagnóstico y alcance',
    'Assessment and scope',
    'Objetivos, usuarios, infraestructura y conexiones necesarias.',
    'Goals, users, infrastructure and required connections.',
  ],
  [
    'Implementación y adaptación',
    'Implementation and adaptation',
    'Instalación, configuración y ajustes incluidos en la propuesta.',
    'Installation, configuration and adjustments included in the proposal.',
  ],
  [
    'Entrega y continuidad',
    'Delivery and continuity',
    'Documentación, acompañamiento y soporte según lo contratado.',
    'Documentation, guidance and support according to the agreement.',
  ],
] as const;
---

<!doctype html>
<html lang="es" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{`${p.name} · Productos Hefesto`}</title>
    <link rel="stylesheet" href="../kraftdo/case.css?v=2" />
    <script is:inline>
      try {
        let p = localStorage.getItem('hefesto-theme') || 'system';
        document.documentElement.dataset.theme =
          p === 'system' ? (matchMedia('(prefers-color-scheme:dark)').matches ? 'dark' : 'light') : p;
      } catch {}
    </script>
    <meta name="description" content={p.intro[0]} />
    <meta property="og:title" content={`${p.name} · Hefesto Studio`} />
    <link rel="canonical" href={`https://hefesto-studio.cl/proyectos/${p.slug}/`} />
    <link rel="stylesheet" href="../products.css?v=1" />
  </head>
  <body>
    <a href="#main" class="skip" data-es="Saltar al contenido" data-en="Skip to content">Saltar al contenido</a>
    <header class="top">
      <a href="../../index.html" class="wordmark">HEFESTO<span> / ESTUDIO</span></a>
      <div class="controls">
        {themes.map((t) => (
          <button
            type="button"
            data-theme-choice={t.value}
            aria-pressed="false"
            data-es={t.es}
            data-en={t.en}
          >
            {t.es}
          </button>
        ))}
        <span class="divider"></span>
        <button type="button" data-lang="es" aria-pressed="true">ES</button>
        <button type="button" data-lang="en" aria-pressed="false">EN</button>
      </div>
    </header>

    <main id="main">
      <section class="product-hero">
        <div class="product-kicker">
          <a href="../../index.html#proyectos">
            <span data-es="← Productos Hefesto" data-en="← Hefesto products">← Productos Hefesto</span>
          </a>
          <span>{`PRODUCT / ${p.num}`}</span>
        </div>
        <div class="product-intro">
          <div>
            <p class="eyebrow">
              {`${p.name} / `}
              <span data-es={p.tag[0]} data-en={p.tag[1]}>{p.tag[0]}</span>
            </p>
            <h1 data-es={p.headline[0]} data-en={p.headline[1]}>{p.headline[0]}</h1>
          </div>
          <div class="product-intro-right">
            <p class="lead" data-es={p.intro[0]} data-en={p.intro[1]}>{p.intro[0]}</p>
            <div class="actions">
              <a class="button" href={`../../index.html?solucion=${p.quote}#cotizador`}>
                <span data-es="Cotizar este producto ↗" data-en="Request a quote ↗">Cotizar este producto ↗</span>
              </a>
              {p.live && (
                <a class="button ghost" target="_blank" rel="noopener noreferrer" href={p.live}>
                  <span data-es="Abrir aplicación ↗" data-en="Open application ↗">Abrir aplicación ↗</span>
                </a>
              )}
            </div>
            <p
              class="product-small"
              data-es="Implementación y adaptación a medida."
              data-en="Custom implementation and adaptation."
            >
              Implementación y adaptación a medida.
            </p>
          </div>
        </div>
        <figure class="product-showcase">
          <button class="zoom-visual" type="button" aria-label="Ampliar imagen">
            <img
              src={`../assets/${p.slug}.svg`}
              width="1440"
              height="930"
              alt={`${p.name} — interfaz ilustrativa con datos de ejemplo`}
              fetchpriority="high"
            />
          </button>
          <figcaption>
            <span
              data-es="Vista ilustrativa del producto · datos de ejemplo · pulsa para ampliar"
              data-en="Illustrative product view · sample data · click to enlarge"
            >
              Vista ilustrativa del producto · datos de ejemplo · pulsa para ampliar
            </span>
          </figcaption>
        </figure>
      </section>

      <section class="section product-outcome">
        <p class="eyebrow">
          01 / <span data-es="PENSADO PARA TU DÍA A DÍA" data-en="DESIGNED FOR EVERYDAY WORK">PENSADO PARA TU DÍA A DÍA</span>
        </p>
        <h2 data-es={p.audience[0]} data-en={p.audience[1]}>{p.audience[0]}</h2>
        <div class="product-features">
          {p.features.map((f, i) => (
            <article>
              <span class="index">{`0${i + 1}`}</span>
              <h3 data-es={f[0]} data-en={f[1]}>{f[0]}</h3>
              <p data-es={f[2]} data-en={f[3]}>{f[2]}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="section product-journey">
        <p class="eyebrow">
          02 / <span data-es="ASÍ FUNCIONA" data-en="HOW IT WORKS">ASÍ FUNCIONA</span>
        </p>
        <h2 data-es="Un recorrido claro." data-en="A clear workflow.">Un recorrido claro.</h2>
        <div class="journey-grid">
          {p.flow.map((f, i) => (
            <article>
              <b>{`0${i + 1}`}</b>
              <h3 data-es={f[0]} data-en={f[1]}>{f[0]}</h3>
              <p data-es={f[2]} data-en={f[3]}>{f[2]}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="section product-delivery">
        <div>
          <p class="eyebrow">
            03 / <span data-es="DE HEFESTO A TU NEGOCIO" data-en="FROM HEFESTO TO YOUR BUSINESS">DE HEFESTO A TU NEGOCIO</span>
          </p>
          <h2 data-es="El software es el comienzo." data-en="Software is the beginning.">El software es el comienzo.</h2>
          <p
            class="lead"
            data-es="Definimos contigo el alcance, configuramos la solución y acordamos cómo mantenerla."
            data-en="We define the scope, configure the solution and agree how to maintain it."
          >
            Definimos contigo el alcance, configuramos la solución y acordamos cómo mantenerla.
          </p>
        </div>
        <div class="delivery-list">
          {deliverySteps.map((f, i) => (
            <article>
              <span class="index">{`0${i + 1}`}</span>
              <div>
                <h3 data-es={f[0]} data-en={f[1]}>{f[0]}</h3>
                <p data-es={f[2]} data-en={f[3]}>{f[2]}</p>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="section">
        <p class="eyebrow">
          04 / <span data-es="INGENIERÍA Y ALCANCE" data-en="ENGINEERING AND SCOPE">INGENIERÍA Y ALCANCE</span>
        </p>
        <div class="stack">
          {p.stack.map((x) => (
            <span>{x}</span>
          ))}
        </div>
        <details class="product-limit">
          <summary>
            <span data-es="Ver estado actual e integraciones" data-en="View current status and integrations">
              Ver estado actual e integraciones
            </span>
          </summary>
          <p data-es={p.limits[0]} data-en={p.limits[1]}>{p.limits[0]}</p>
        </details>
        {p.faq.map((f) => (
          <details class="product-limit">
            <summary><span data-es={f[0]} data-en={f[1]}>{f[0]}</span></summary>
            <p data-es={f[2]} data-en={f[3]}>{f[2]}</p>
          </details>
        ))}
      </section>

      <section class="section product-close">
        <p class="eyebrow">{`${p.name} × HEFESTO`}</p>
        <h2 data-es={'Hagámoslo parte\nde tu negocio.'} data-en={'Make it part\nof your business.'}>
          {'Hagámoslo parte\nde tu negocio.'}
        </h2>
        <a class="button" href={`../../index.html?solucion=${p.quote}#cotizador`}>
          <span data-es="Solicitar propuesta ↗" data-en="Request a proposal ↗">Solicitar propuesta ↗</span>
        </a>
        <p
          class="product-small"
          data-es="Sin compra automática. Alcance, costos y plazos se acuerdan en la cotización."
          data-en="No automatic purchase. Scope, costs and timelines are agreed in the quotation."
        >
          Sin compra automática. Alcance, costos y plazos se acuerdan en la cotización.
        </p>
      </section>
    </main>

    <footer>
      <a href="../../index.html">← HEFESTO STUDIO</a>
      <a href="../../index.html#plantillas">
        <span data-es="Explorar plantillas" data-en="Explore templates">Explorar plantillas</span>
      </a>
    </footer>

    <dialog id="visual-dialog">
      <button type="button" class="visual-close" aria-label="Cerrar imagen">×</button>
      <img
        src={`../assets/${p.slug}.svg`}
        width="1440"
        height="930"
        alt={`${p.name} — vista ilustrativa ampliada`}
      />
    </dialog>

    <script is:inline src="../kraftdo/case.js?v=2"></script>
    <script is:inline src="../products.js?v=1"></script>
  </body>
</html>
