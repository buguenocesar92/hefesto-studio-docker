{
  "name": "hefesto-studio",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "build": "astro build && python3 scripts/sync-collection.py",
    "preview": "astro preview --host 0.0.0.0",
    "check": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:dom": "node scripts/test-unified.cjs && node scripts/test-kraftdo.cjs && node scripts/test-solutions.cjs && node scripts/test-portable-ui.cjs",
    "test": "vitest run && node scripts/test-unified.cjs && node scripts/test-kraftdo.cjs && node scripts/test-solutions.cjs && node scripts/test-portable-ui.cjs"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.2",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.4.4",
    "lucide-react": "^1.64.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^26.1.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
