# Copy to .env; never commit the filled file.
APP_URL=http://localhost:8080
SITE_ADDRESS=:80
HTTP_PORT=8080
HTTPS_PORT=8443
PGDATABASE=hefesto
PGUSER=hefesto
PGPASSWORD=REPLACE_WITH_RANDOM_DATABASE_PASSWORD
ADMIN_API_TOKEN=REPLACE_WITH_RANDOM_TOKEN_AT_LEAST_32_CHARACTERS
